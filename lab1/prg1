#include <iostream>
using namespace std;

int main() 
{
    int q,p,y,x; //Создание переменных
    cout<<"Enter the coordinates of the triangle"<<endl;
    cin >> q >> p; //Ввод координат прямого угла
    if (q != p) //Условие того, что x != y
        do 
        {
          cout <<"Enter the coordinate x"<<endl; //Ввод координаы x
          cin >> x;
          cout <<"Enter the coordinate y"<<endl; //Ввод координаы y
          cin >> y;
          if (q > p) 
            { // Прямой угол ниже прямой y = x
                if (x<=q && y>=p && x>=y) 
                    {
                    cout << "Point ("<< x<<","<<y<<") is located in the triangle" << endl;
                    }
                else 
                    {
                    cout << "Point ("<< x<<","<<y<<") isn't located in the triangle" << endl;
                    }
            }
            else // Прямой угол выше прямой y = x
                if (x>=q && y<=p && y>=x) 
                    {
                    cout << "Point ("<< x<<","<<y<<") is located in the triangle" << endl;
                    }
                else 
                    {
                    cout << "Point ("<< x<<","<<y<<") isn't located in the triangle" << endl;
                    }
        }
    while (x != 0 || y != 0); //Завершение прг
    {
    cout << "End of input" << endl;
    }
    return 0;
}
